{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["renderer/**/*.ts", "renderer/**/*.vue", "src/app/contracts.ts"]
}
